# 3rd World (astra) — Supabase cloud saves + private admin.
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is safe to ship in the browser: Row Level Security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Website / Google AdSense (optional).
VITE_SITE_URL=https://3rdworld.vercel.app
VITE_CONTACT_EMAIL=you@example.com
# AdSense publisher ID. Defaults to the site's own ID in vite.config.js; set to 'off' to disable ads.
# VITE_ADSENSE_CLIENT=ca-pub-9371827738055837
